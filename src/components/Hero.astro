---
import HeroOffer from "./HeroOffer.astro";
---

<section class="hero-section">
  <div class="container">
    <!-- Top Hero Row: Headline on left, Countdown on right -->
    <div class="hero-top-grid">
      <div class="hero-headline-block">
        <h1 class="hero-title font-serif">
          The first<br />
          of its kind. <span class="sparkle-emoji">✨</span>
        </h1>
        <!-- Playful yellow hand-drawn underline -->
        <svg
          class="wavy-underline left"
          viewBox="0 0 140 14"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M 3 8 Q 25 1, 48 8 T 92 8 T 136 8"
            stroke="#F4BF3A"
            stroke-width="4.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <div class="hero-countdown-block">
        <div class="countdown-badge-wrapper">
          <span class="countdown-heading font-serif">Coming soon 🎉</span>
        </div>

        <div
          class="countdown-grid"
          id="countdown-timer"
          aria-label="Countdown to launch"
        >
          <div class="countdown-card">
            <span class="countdown-value" id="days-val">164</span>
            <span class="countdown-label">DAYS</span>
          </div>
          <div class="countdown-card">
            <span class="countdown-value" id="hours-val">15</span>
            <span class="countdown-label">HRS</span>
          </div>
          <div class="countdown-card">
            <span class="countdown-value" id="minutes-val">15</span>
            <span class="countdown-label">MIN</span>
          </div>
          <div class="countdown-card">
            <span class="countdown-value" id="seconds-val">43</span>
            <span class="countdown-label">SEC</span>
          </div>
        </div>

        <p class="countdown-subtext">
          First 1,000 founder spots close 5 April 2027
        </p>
      </div>
    </div>

    <!-- Founder Offer Block: 50% Off & Free Membership Cards -->
    <HeroOffer />

    <!-- Video Showcase Card (peeping through / interactive player) -->
    <div class="hero-video-wrapper">
      <div
        class="video-card"
        id="open-video-btn"
        role="button"
        tabindex="0"
        aria-label="Play Jane's story video"
      >
        <!-- Top-left custom arch corner mark from video -->
        <div class="corner-mark top-left">
          <svg
            viewBox="0 0 40 40"
            width="36"
            height="36"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M 8 28 C 12 12, 28 12, 32 28"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="20" cy="18" r="2.2" fill="#181512"></circle>
          </svg>
        </div>

        <!-- Center Interactive Play Button -->
        <div class="play-button-circle">
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="#181512"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M 8 5 V 19 L 19 12 Z"></path>
          </svg>
        </div>

        <!-- Bottom-right custom arch corner mark from video -->
        <div class="corner-mark bottom-right">
          <svg
            viewBox="0 0 40 40"
            width="36"
            height="36"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M 8 16 C 12 28, 28 28, 32 16"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="15" cy="22" r="1.5" fill="#181512"></circle>
            <circle cx="25" cy="22" r="1.5" fill="#181512"></circle>
          </svg>
        </div>

        <div class="video-overlay-hint">
          <span>Click to watch Jane's story</span>
        </div>
      </div>

      <!-- Below Video Sub-Hero: Call to Action -->
      <div class="hero-cta-group">
        <h2 class="sub-hero-heading font-serif">
          Join Jane and beat the rush 🏃
        </h2>
        <a href="#founder-offer" class="btn-pill-yellow hero-join-btn">
          JOIN NOW
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Live ticking countdown to April 5, 2027
  function updateCountdown() {
    const targetDate = new Date("April 5, 2027 09:00:00 GMT+0000").getTime();
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance > 0) {
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor(
        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
      );
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      const dEl = document.getElementById("days-val");
      const hEl = document.getElementById("hours-val");
      const mEl = document.getElementById("minutes-val");
      const sEl = document.getElementById("seconds-val");

      if (dEl) dEl.innerText = String(days);
      if (hEl) hEl.innerText = String(hours).padStart(2, "0");
      if (mEl) mEl.innerText = String(minutes).padStart(2, "0");
      if (sEl) sEl.innerText = String(seconds).padStart(2, "0");
    }
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Sync social proof spots counter with localStorage if updated
  function syncSpotsCount() {
    const claimed = localStorage.getItem("kind_spots_claimed") || "0";
    document.querySelectorAll(".spots-counter-sync").forEach((el) => {
      el.textContent = claimed;
    });
  }
  syncSpotsCount();
  window.addEventListener("storage", syncSpotsCount);
  window.addEventListener("kind-waitlist-updated", syncSpotsCount);
</script>

<style>
  .hero-section {
    padding: 30px 0 40px;
    background-color: var(--bg-page);
  }

  .hero-top-grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 54px;
    flex-wrap: wrap;
  }

  .hero-headline-block {
    flex: 1;
    min-width: 290px;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    color: var(--text-dark);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .sparkle-emoji {
    display: inline-block;
    filter: drop-shadow(0 2px 4px rgba(244, 191, 58, 0.4));
  }

  .hero-countdown-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .countdown-badge-wrapper {
    margin-bottom: 12px;
  }

  .countdown-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-dark);
  }

  .countdown-grid {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .countdown-card {
    background-color: #1f1b18;
    color: #ffffff;
    width: 62px;
    height: 68px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .countdown-value {
    font-family: var(--font-sans);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }

  .countdown-label {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    color: #a9a29a;
    letter-spacing: 0.08em;
  }

  .countdown-subtext {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 10px;
  }

  /* Video Card */
  .hero-video-wrapper {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .video-card {
    width: 100%;
    aspect-ratio: 16 / 9.8;
    max-height: 400px;
    background: linear-gradient(135deg, #f08253 0%, #f5a145 45%, #f6c043 100%);
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: 4px 4px 0px var(--border-ink);
    position: relative;
    cursor: pointer;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.22s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.22s ease;
  }

  .video-card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0px var(--border-ink);
  }

  .corner-mark {
    position: absolute;
    pointer-events: none;
    z-index: 2;
  }

  .corner-mark.top-left {
    top: 18px;
    left: 20px;
  }

  .corner-mark.bottom-right {
    bottom: 16px;
    right: 20px;
  }

  .play-button-circle {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background-color: #ffffff;
    border: var(--border-width) solid var(--border-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
    padding-left: 3px;
    z-index: 3;
  }

  .video-card:hover .play-button-circle {
    transform: scale(1.1);
    background-color: #fffdf8;
  }

  .video-overlay-hint {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(24, 21, 18, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: var(--radius-full);
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .video-card:hover .video-overlay-hint {
    opacity: 1;
  }

  /* Below Video CTA Group */
  .hero-cta-group {
    margin-top: 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sub-hero-heading {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 16px;
  }

  .hero-join-btn {
    padding: 12px 34px;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .hero-social-proof {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .hero-top-grid {
      flex-direction: column;
      align-items: stretch;
      gap: 30px;
    }
    .hero-countdown-block {
      align-items: flex-start;
    }
    .countdown-grid {
      width: 100%;
      justify-content: space-between;
    }
    .countdown-card {
      flex: 1;
      max-width: 72px;
    }
  }
</style>
