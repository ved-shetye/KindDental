---
---

<section class="offer-section" id="founder-offer">
  <div class="container-narrow">
    <div class="offer-card editorial-card">
      <div class="offer-header">
        <span class="offer-badge font-sans">FOUNDER WAITLIST — LIMITED TO 1,000</span>
        <h2 class="offer-title font-serif">Be one of the first 1,000 🎉</h2>
        <p class="offer-subtitle">
          Join before we open and lock in the Founder offer — before any public pricing applies.
        </p>
      </div>

      <!-- 3 Key Benefits -->
      <ul class="benefits-list" role="list">
        <li class="benefit-item">
          <div class="check-circle" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" stroke="#181512"/>
              <polyline points="8 12 11 15 16 9" stroke="#181512"/>
            </svg>
          </div>
          <div class="benefit-content">
            <strong class="benefit-headline">Free membership for a year</strong>
            <span class="benefit-desc">Full Founder Membership on us at launch.</span>
          </div>
        </li>

        <li class="benefit-item">
          <div class="check-circle" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" stroke="#181512"/>
              <polyline points="8 12 11 15 16 9" stroke="#181512"/>
            </svg>
          </div>
          <div class="benefit-content">
            <strong class="benefit-headline">Discounted whitening</strong>
            <span class="benefit-desc">Founder pricing on your first whitening treatment.</span>
          </div>
        </li>

        <li class="benefit-item">
          <div class="check-circle" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" stroke="#181512"/>
              <polyline points="8 12 11 15 16 9" stroke="#181512"/>
            </svg>
          </div>
          <div class="benefit-content">
            <strong class="benefit-headline">Early access</strong>
            <span class="benefit-desc">First to book, ahead of the public, when we open.</span>
          </div>
        </li>
      </ul>

      <!-- Spots Claimed Progress Bar -->
      <div class="progress-block">
        <div class="progress-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="1000">
          <div class="progress-bar-fill" id="progress-fill" style="width: 2%;"></div>
        </div>
        <p class="progress-label font-sans">
          <strong class="spots-counter-sync" id="claimed-count-text">0</strong> of 1,000 Founder spots claimed
        </p>
      </div>

      <!-- Waitlist Form (JotForm style interactive form) -->
      <form class="waitlist-form" id="founder-waitlist-form" novalidate>
        <div class="form-group">
          <label for="founder-name" class="form-label">NAME</label>
          <input
            type="text"
            id="founder-name"
            name="name"
            placeholder="Your name"
            required
            class="form-input"
            autocomplete="name"
          />
        </div>

        <div class="form-group">
          <label for="founder-email" class="form-label">EMAIL</label>
          <input
            type="email"
            id="founder-email"
            name="email"
            placeholder="you@email.com"
            required
            class="form-input"
            autocomplete="email"
          />
        </div>

        <button type="submit" class="submit-founder-btn font-sans" id="submit-btn">
          Join the Founder Waitlist
        </button>

        <p class="form-microcopy">
          No spam — just one message when we open, and early access to Founder Membership pricing.
        </p>
      </form>

      <!-- Success State Confirmation (hidden by default) -->
      <div class="waitlist-success" id="waitlist-success" style="display: none;">
        <div class="success-badge-icon">🎉</div>
        <h3 class="success-title font-serif">You're on the Founder List!</h3>
        <p class="success-message" id="success-user-msg">
          We've reserved your spot. We'll send your private founder invitation before public booking opens.
        </p>
        <div class="founder-pass-card">
          <span class="pass-tag">FOUNDER PASS</span>
          <span class="pass-number" id="pass-number-display">SPOT #042</span>
          <span class="pass-status">LOCKED IN · CENTRE:MK</span>
        </div>
        <button type="button" class="btn-pill-dark reset-waitlist-btn" id="reset-waitlist-btn">
          Register Another Person
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Waitlist form interactive submission logic
  const form = document.getElementById('founder-waitlist-form') as HTMLFormElement | null;
  const successBox = document.getElementById('waitlist-success');
  const progressFill = document.getElementById('progress-fill');
  const claimedCountEl = document.getElementById('claimed-count-text');
  const passNumEl = document.getElementById('pass-number-display');
  const resetBtn = document.getElementById('reset-waitlist-btn');

  function getStoredClaims(): number {
    const stored = localStorage.getItem('kind_spots_claimed');
    return stored ? parseInt(stored, 10) : 184; // realistic seed starting around ~184 spots claimed
  }

  function renderClaimStatus() {
    const claims = getStoredClaims();
    if (claimedCountEl) claimedCountEl.textContent = claims.toLocaleString();
    if (progressFill) {
      const percentage = Math.min(Math.max((claims / 1000) * 100, 4), 100);
      progressFill.style.width = `${percentage}%`;
    }
    // Also notify other counters across page
    window.dispatchEvent(new Event('kind-waitlist-updated'));
  }

  // Check if current user already submitted
  const savedUser = localStorage.getItem('kind_founder_member');
  if (savedUser && form && successBox) {
    try {
      const parsed = JSON.parse(savedUser);
      form.style.display = 'none';
      successBox.style.display = 'flex';
      if (passNumEl) passNumEl.textContent = `SPOT #${String(parsed.spot).padStart(3, '0')}`;
    } catch (_) {}
  }

  renderClaimStatus();

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('founder-name') as HTMLInputElement;
      const emailInput = document.getElementById('founder-email') as HTMLInputElement;

      if (!nameInput.value.trim()) {
        nameInput.focus();
        nameInput.style.borderColor = '#EA695B';
        return;
      }
      if (!emailInput.value.trim() || !emailInput.value.includes('@')) {
        emailInput.focus();
        emailInput.style.borderColor = '#EA695B';
        return;
      }

      const currentClaims = getStoredClaims() + 1;
      localStorage.setItem('kind_spots_claimed', String(currentClaims));

      const memberData = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        spot: currentClaims,
        date: new Date().toISOString()
      };
      localStorage.setItem('kind_founder_member', JSON.stringify(memberData));

      // Trigger Confetti!
      // @ts-ignore
      if (typeof confetti === 'function') {
        // @ts-ignore
        confetti({
          particleCount: 80,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#F4BF3A', '#B85834', '#4BB58B', '#EA695B', '#4E9CD4']
        });
      }

      renderClaimStatus();

      form.style.display = 'none';
      if (successBox) {
        successBox.style.display = 'flex';
        if (passNumEl) passNumEl.textContent = `SPOT #${String(currentClaims).padStart(3, '0')}`;
      }
    });
  }

  if (resetBtn && form && successBox) {
    resetBtn.addEventListener('click', () => {
      form.reset();
      form.style.display = 'flex';
      successBox.style.display = 'none';
      localStorage.removeItem('kind_founder_member');
    });
  }
</script>

<style>
  .offer-section {
    padding: 60px 0 80px;
    background-color: var(--bg-page);
  }

  .offer-card {
    background-color: var(--bg-card);
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: 56px 48px;
    margin: 0 auto;
    position: relative;
  }

  .offer-header {
    text-align: center;
    margin-bottom: 34px;
  }

  .offer-badge {
    color: var(--brand-terracotta);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    display: inline-block;
    margin-bottom: 12px;
  }

  .offer-title {
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    line-height: 1.15;
    color: var(--text-dark);
    margin-bottom: 14px;
    font-weight: 600;
  }

  .offer-subtitle {
    font-size: 0.96rem;
    color: var(--text-muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Benefits List */
  .benefits-list {
    list-style: none;
    max-width: 480px;
    margin: 0 auto 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .check-circle {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .benefit-content {
    display: flex;
    flex-direction: column;
  }

  .benefit-headline {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.3;
  }

  .benefit-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Progress Bar */
  .progress-block {
    max-width: 480px;
    margin: 0 auto 34px;
  }

  .progress-track {
    width: 100%;
    height: 12px;
    background-color: var(--bg-page);
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: 10px;
  }

  .progress-bar-fill {
    height: 100%;
    background-color: var(--border-ink);
    border-radius: var(--radius-full);
    transition: width 0.6s cubic-bezier(0.2, 0, 0, 1);
  }

  .progress-label {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dark);
    font-weight: 500;
  }

  /* Form */
  .waitlist-form {
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .form-input {
    width: 100%;
    background-color: var(--bg-page);
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    font-size: 0.98rem;
    font-family: var(--font-sans);
    color: var(--text-dark);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus {
    border-color: var(--brand-terracotta);
    box-shadow: 0 0 0 3px rgba(184, 88, 52, 0.15);
  }

  .form-input::placeholder {
    color: #A39B92;
  }

  .submit-founder-btn {
    width: 100%;
    background-color: var(--brand-yellow);
    color: var(--text-dark);
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-full);
    padding: 15px 24px;
    font-size: 1.02rem;
    font-weight: 700;
    box-shadow: var(--shadow-sm);
    margin-top: 6px;
    transition: all 0.18s ease;
  }

  .submit-founder-btn:hover {
    background-color: #F8CB54;
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-md);
  }

  .submit-founder-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--border-ink);
  }

  .form-microcopy {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-top: 4px;
  }

  /* Success State */
  .waitlist-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    max-width: 480px;
    margin: 0 auto;
    padding: 20px 0;
  }

  .success-badge-icon {
    font-size: 3rem;
  }

  .success-title {
    font-size: 1.8rem;
    color: var(--text-dark);
  }

  .success-message {
    font-size: 0.94rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .founder-pass-card {
    background: #FFFFFF;
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 20px 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 12px 0;
  }

  .pass-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--brand-terracotta);
  }

  .pass-number {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .pass-status {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #4BB58B;
  }

  .reset-waitlist-btn {
    font-size: 0.85rem;
    padding: 8px 18px;
    margin-top: 8px;
  }

  @media (max-width: 640px) {
    .offer-card {
      padding: 36px 20px;
    }
  }
</style>
