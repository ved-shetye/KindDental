---

---

<section class="concept-section" id="concept">
  <div class="container">
    <div class="section-title-wrapper">
      <span class="section-tag font-sans">THE CONCEPT</span>
      <h2 class="section-heading font-serif">
        Dentistry, rebuilt around how people feel 💛
      </h2>
      <!-- Yellow Wavy Underline -->
      <svg
        class="wavy-underline"
        viewBox="0 0 140 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 3 8 Q 25 1, 48 8 T 92 8 T 136 8"
          stroke="#F4BF3A"
          stroke-width="4.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <!-- 4 Interlocking Puzzle Pieces in 2x2 Grid -->
    <div class="puzzle-container" aria-label="Core values puzzle">
      <div class="puzzle-grid">
        <!-- 1. Prevention (Top-Left) -> Lights up Mint Green -->
        <div
          class="puzzle-item"
          data-value="prevention"
          tabindex="0"
          role="button"
          aria-label="Core Value: Prevention"
        >
          <svg
            class="puzzle-svg"
            viewBox="-5 -5 195 195"
            preserveAspectRatio="none"
          >
            <!-- Top: flat, Right: tab (out), Bottom: tab (out), Left: flat -->
            <path
              class="puzzle-path piece-prevention"
              d="
                M 12 0
                H 148
                A 12 12 0 0 1 160 12
                V 60
                C 158 52, 185 52, 185 80
                C 185 108, 158 108, 160 100
                V 148
                A 12 12 0 0 1 148 160
                H 100
                C 108 158, 108 185, 80 185
                C 52 185, 52 158, 60 160
                H 12
                A 12 12 0 0 1 0 148
                V 12
                A 12 12 0 0 1 12 0
                Z
              "
            ></path>
          </svg>
          <div class="puzzle-label font-serif">Prevention</div>
        </div>

        <!-- 2. Innovation (Top-Right) -> Lights up Blue -->
        <div
          class="puzzle-item"
          data-value="innovation"
          tabindex="0"
          role="button"
          aria-label="Core Value: Innovation"
        >
          <svg
            class="puzzle-svg"
            viewBox="-5 -5 195 195"
            preserveAspectRatio="none"
          >
            <!-- Top: flat, Right: flat, Bottom: tab (out), Left: hole (in) -->
            <path
              class="puzzle-path piece-innovation"
              d="
                M 12 0
                H 148
                A 12 12 0 0 1 160 12
                V 148
                A 12 12 0 0 1 148 160
                H 100
                C 108 158, 108 185, 80 185
                C 52 185, 52 158, 60 160
                H 12
                A 12 12 0 0 1 0 148
                V 100
                C 2 108, 25 108, 25 80
                C 25 52, 2 52, 0 60
                V 12
                A 12 12 0 0 1 12 0
                Z
              "
            ></path>
          </svg>
          <div class="puzzle-label font-serif">Innovation</div>
        </div>

        <!-- 3. Clarity (Bottom-Left) -> Lights up Soft Pink/Peach -->
        <div
          class="puzzle-item"
          data-value="clarity"
          tabindex="0"
          role="button"
          aria-label="Core Value: Clarity"
        >
          <svg
            class="puzzle-svg"
            viewBox="-5 -5 195 195"
            preserveAspectRatio="none"
          >
            <!-- Top: hole (in), Right: tab (out), Bottom: flat, Left: flat -->
            <path
              class="puzzle-path piece-clarity"
              d="
                M 12 0
                H 60
                C 52 2, 52 25, 80 25
                C 108 25, 108 2, 100 0
                H 148
                A 12 12 0 0 1 160 12
                V 60
                C 158 52, 185 52, 185 80
                C 185 108, 158 108, 160 100
                V 148
                A 12 12 0 0 1 148 160
                H 12
                A 12 12 0 0 1 0 148
                V 12
                A 12 12 0 0 1 12 0
                Z
              "
            ></path>
          </svg>
          <div class="puzzle-label font-serif">Clarity</div>
        </div>

        <!-- 4. Kindness (Bottom-Right) -> Lights up Yellow -->
        <div
          class="puzzle-item"
          data-value="kindness"
          tabindex="0"
          role="button"
          aria-label="Core Value: Kindness"
        >
          <svg
            class="puzzle-svg"
            viewBox="-5 -5 195 195"
            preserveAspectRatio="none"
          >
            <!-- Top: hole (in), Right: flat, Bottom: flat, Left: hole (in) -->
            <path
              class="puzzle-path piece-kindness"
              d="
                M 12 0
                H 60
                C 52 2, 52 25, 80 25
                C 108 25, 108 2, 100 0
                H 148
                A 12 12 0 0 1 160 12
                V 148
                A 12 12 0 0 1 148 160
                H 12
                A 12 12 0 0 1 0 148
                V 100
                C 2 108, 25 108, 25 80
                C 25 52, 2 52, 0 60
                V 12
                A 12 12 0 0 1 12 0
                Z
              "
            ></path>
          </svg>
          <div class="puzzle-label font-serif">Kindness</div>
        </div>
      </div>
    </div>

    <!-- Charity Pledge Card -->
    <div class="pledge-card-wrapper">
      <div class="pledge-card editorial-card">
        <div class="pledge-heart-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="28"
            height="28"
            fill="none"
            stroke="#181512"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M 20.84 4.61 a 5.5 5.5 0 0 0 -7.78 0 L 12 5.67 l -1.06 -1.06 a 5.5 5.5 0 0 0 -7.78 7.78 l 1.06 1.06 L 12 21.23 l 7.78 -7.78 1.06 -1.06 a 5.5 5.5 0 0 0 0 -7.78 z"
            ></path>
          </svg>
        </div>
        <p class="pledge-text font-sans">
          Kind Dental also has a pledge supporting dental charities in the UK
          and abroad, to make a bigger impact.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .concept-section {
    padding: 50px 0 70px;
    background-color: var(--bg-page);
  }

  .section-title-wrapper {
    text-align: center;
    margin-bottom: 50px;
  }

  /* Puzzle Layout */
  .puzzle-container {
    display: flex;
    justify-content: center;
    margin-bottom: 54px;
  }

  .puzzle-grid {
    display: grid;
    grid-template-columns: repeat(2, 175px);
    grid-template-rows: repeat(2, 175px);
    gap: 14px;
    position: relative;
  }

  .puzzle-item {
    position: relative;
    width: 175px;
    height: 175px;
    cursor: pointer;
    outline: none;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
  }

  .puzzle-item:hover,
  .puzzle-item:focus-visible {
    transform: scale(1.03);
    z-index: 10;
  }

  .puzzle-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(2px 2px 0px #181512);
  }

  .puzzle-path {
    fill: #efe9df;
    stroke: #181512;
    stroke-width: 2.2px;
    stroke-linejoin: round;
    transition:
      fill 0.25s ease,
      filter 0.25s ease;
  }

  /* Hover color states matching video */
  .puzzle-item:hover .piece-kindness,
  .puzzle-item:focus-visible .piece-kindness {
    fill: var(--brand-yellow);
  }

  .puzzle-item:hover .piece-prevention,
  .puzzle-item:focus-visible .piece-prevention {
    fill: var(--brand-mint);
  }

  .puzzle-item:hover .piece-innovation,
  .puzzle-item:focus-visible .piece-innovation {
    fill: var(--brand-blue);
  }

  .puzzle-item:hover .piece-clarity,
  .puzzle-item:focus-visible .piece-clarity {
    fill: #eba99c;
  }

  .puzzle-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-dark);
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.01em;
  }

  /* Pledge Card */
  .pledge-card-wrapper {
    max-width: 620px;
    margin: 0 auto;
  }

  .pledge-card {
    background-color: #efe9df;
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    padding: 32px 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .pledge-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .pledge-heart-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dark);
  }

  .pledge-text {
    font-size: 0.96rem;
    color: var(--text-dark);
    line-height: 1.5;
    max-width: 480px;
  }

  @media (max-width: 500px) {
    .puzzle-grid {
      grid-template-columns: repeat(2, 140px);
      grid-template-rows: repeat(2, 140px);
      gap: 10px;
    }
    .puzzle-item {
      width: 140px;
      height: 140px;
    }
    .puzzle-label {
      font-size: 0.98rem;
    }
  }
</style>
