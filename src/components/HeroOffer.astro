---
// HeroOffer.astro — Early Founder Offer block placed after the homepage title and above the video
---

<div class="hero-offer-wrapper" id="hero-offer">
  <!-- Section Title & Subheading -->
  <div class="hero-offer-header">
    <h2 class="hero-offer-title font-serif">
      The first 1,000 get<br />
      <span class="text-terracotta">50% off</span> and more. <span
        class="celebration-emoji">🎉</span
      >
    </h2>
    <p class="hero-offer-subtitle">Sign up now to beat the rush.</p>
  </div>

  <!-- 3 Pricing & Bonus Cards -->
  <div class="hero-offer-grid">
    <!-- Card 1: Hygiene & air polish -->
    <div class="offer-card standard-card">
      <div class="offer-card-top">
        <span class="badge-discount font-sans">50% OFF</span>
        <h3 class="offer-card-title font-serif">Hygiene & air polish</h3>
      </div>
      <div class="offer-pricing-block">
        <span class="price-original font-sans">&pound;125</span>
        <span class="price-discounted font-serif">&pound;62.50</span>
        <span class="price-savings font-sans">Save &pound;62.50</span>
      </div>
      <div class="card-footer-spacer" aria-hidden="true"></div>
    </div>

    <!-- Card 2: Teeth whitening -->
    <div class="offer-card standard-card">
      <div class="offer-card-top">
        <span class="badge-discount font-sans">50% OFF</span>
        <h3 class="offer-card-title font-serif">Teeth whitening</h3>
      </div>
      <div class="offer-pricing-block">
        <span class="price-original font-sans">&pound;300</span>
        <span class="price-discounted font-serif">&pound;150</span>
        <span class="price-savings font-sans">Save &pound;150</span>
      </div>
      <p class="card-disclaimer font-sans">Subject to clinical suitability.</p>
    </div>

    <!-- Card 3: First year's membership bonus -->
    <div class="offer-card bonus-card">
      <div class="bonus-card-top">
        <div class="gift-icon-wrap" aria-hidden="true">
          <svg
            viewBox="0 0 32 32"
            width="24"
            height="24"
            fill="none"
            stroke="#B85834"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Bow Loops -->
            <path d="M16 11C13.5 6.2 7 7.2 9.5 11C12 11 16 11 16 11Z"></path>
            <path d="M16 11C18.5 6.2 25 7.2 22.5 11C20 11 16 11 16 11Z"></path>
            <!-- Box Lid -->
            <rect x="5" y="11" width="22" height="4.5" rx="1.5"></rect>
            <!-- Box Body -->
            <rect x="7" y="15.5" width="18" height="11.5" rx="1.5"></rect>
            <!-- Ribbon Center Line -->
            <line x1="16" y1="11" x2="16" y2="27"></line>
          </svg>
        </div>
        <span class="bonus-tagline text-dark font-sans"
          >YOUR <span class="text-gold">FOUNDING MEMBER</span> BONUS</span
        >
        <h3 class="offer-card-title font-serif">
          Digital Dental Health Report
        </h3>
      </div>
      <div class="offer-pricing-block">
        <span class="bonus-free-text font-serif">FREE</span>
        <span class="price-savings font-sans">Worth &pound;45</span>
      </div>
      <div class="bonus-divider"></div>
      <p class="bonus-footer-text font-sans">
        As part of your free 1st year membership
      </p>
    </div>
  </div>

  <!-- Bottom CTA & Deposit Details -->
  <div class="hero-offer-action">
    <a
      href="#founder-offer"
      class="btn-secure-offer font-sans"
      id="secure-offer-btn"
    >
      <span>Secure my offer</span>
      <svg
        viewBox="0 0 20 20"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M 4 10 H 16 M 11 5 L 16 10 L 11 15"></path>
      </svg>
    </a>

    <div class="deposit-details">
      <h3 class="deposit-headline font-serif">
        <span class="text-terracotta font-serif">&pound;10</span> refundable deposit
      </h3>
      <p class="deposit-copy-primary font-sans">
        Refundable before you book. Deducted from your hygiene appointment.
      </p>
      <p class="deposit-copy-secondary font-sans">
        Pay the remaining balance when appointment bookings open.
      </p>
      <button
        type="button"
        class="deposit-terms-link font-sans"
        id="toggle-terms-btn"
      >
        Offer terms apply.
      </button>

      <!-- Expandable Terms Accordion -->
      <div
        class="terms-expandable"
        id="terms-expandable"
        style="display: none;"
      >
        <div class="terms-box">
          <p>
            <strong>Founding Member Offer Terms:</strong> Valid for the first 1,000
            verified founder sign-ups prior to official clinic opening. The &pound;10
            reservation deposit is fully refundable at any point before booking confirmation,
            and is credited toward your first hygiene & air polish appointment upon
            booking. Teeth whitening is subject to in-clinic clinical suitability
            assessment. One membership per person.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Smooth scroll and focus on Founder Waitlist form when clicking "Secure my offer"
  const secureOfferBtn = document.getElementById("secure-offer-btn");
  if (secureOfferBtn) {
    secureOfferBtn.addEventListener("click", (e) => {
      e.preventDefault();
      const target = document.getElementById("founder-offer");
      if (target) {
        target.scrollIntoView({ behavior: "smooth", block: "center" });
        // After scrolling, focus name input
        setTimeout(() => {
          const nameInput = document.getElementById(
            "founder-name",
          ) as HTMLInputElement | null;
          if (nameInput) {
            nameInput.focus();
            nameInput.classList.add("highlight-glow");
            setTimeout(
              () => nameInput.classList.remove("highlight-glow"),
              2000,
            );
          }
        }, 500);
      }
    });
  }

  // Toggle Terms details
  const termsBtn = document.getElementById("toggle-terms-btn");
  const termsExpandable = document.getElementById("terms-expandable");
  if (termsBtn && termsExpandable) {
    termsBtn.addEventListener("click", () => {
      const isHidden = termsExpandable.style.display === "none";
      termsExpandable.style.display = isHidden ? "block" : "none";
      termsBtn.setAttribute("aria-expanded", isHidden ? "true" : "false");
    });
  }
</script>

<style>
  .hero-offer-wrapper {
    width: 100%;
    max-width: 990px;
    margin: 0 auto 40px;
    padding: 0 7px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header */
  .hero-offer-header {
    text-align: center;
    margin-bottom: 15px;
  }

  .hero-offer-title {
    font-size: clamp(1.85rem, 3.6vw, 2.5rem);
    line-height: 1.12;
    color: var(--text-dark, #181512);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .text-terracotta {
    color: var(--brand-terracotta, #b85834);
    font-weight: 700;
  }

  .celebration-emoji {
    display: inline-block;
    filter: drop-shadow(0 2px 4px rgba(244, 191, 58, 0.4));
  }

  .hero-offer-subtitle {
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    font-weight: 600;
    color: var(--text-dark, #181512);
    margin-top: 5px;
  }

  /* Cards Grid */
  .hero-offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: 100%;
    margin-bottom: 24px;
  }

  .offer-card {
    border-radius: 14px;
    padding: 22px 16px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    transition:
      transform 0.22s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.22s ease;
  }

  .offer-card:hover {
    transform: translateY(-3px);
  }

  /* Standard Card (Cards 1 & 2) */
  .standard-card {
    background-color: #ffffff;
    border: 1.5px solid #e6ded5;
    box-shadow: 0 3px 12px rgba(24, 21, 18, 0.04);
  }

  .standard-card:hover {
    box-shadow: 0 8px 22px rgba(24, 21, 18, 0.08);
  }

  /* Bonus Card (Card 3) */
  .bonus-card {
    background-color: #fdefe5;
    border: 1.5px solid #f6ded0;
    box-shadow: 0 3px 12px rgba(184, 88, 52, 0.05);
  }

  .bonus-card:hover {
    box-shadow: 0 8px 22px rgba(184, 88, 52, 0.12);
  }

  /* Card Header Elements */
  .offer-card-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 8px;
  }

  .badge-discount {
    background-color: var(--brand-terracotta, #b85834);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 12px;
    border-radius: var(--radius-full, 9999px);
    display: inline-block;
    margin-bottom: 12px;
  }

  .bonus-card-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 8px;
  }

  .gift-icon-wrap {
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bonus-tagline {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .text-gold {
    color: var(--brand-gold, #b8860b);
  }

  .offer-card-title {
    font-size: clamp(1.05rem, 1.35vw, 1.18rem);
    font-weight: 600;
    color: var(--text-dark, #181512);
    line-height: 1.2;
    min-height: 2.1em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Pricing Block */
  .offer-pricing-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 8px;
    width: 100%;
  }

  .price-original {
    font-size: 0.88rem;
    color: #8c847b;
    text-decoration: line-through;
    font-weight: 500;
    line-height: 1;
    margin-bottom: 2px;
  }

  .price-discounted {
    font-size: clamp(2.1rem, 2.8vw, 2.5rem);
    font-weight: 700;
    color: var(--brand-terracotta, #b85834);
    line-height: 1.02;
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }

  .bonus-free-text {
    font-size: clamp(2.2rem, 3vw, 2.6rem);
    font-weight: 700;
    color: var(--brand-terracotta, #b85834);
    line-height: 1.02;
    margin-bottom: 4px;
    letter-spacing: 0.02em;
  }

  .price-savings {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-dark, #181512);
    line-height: 1.2;
  }

  /* Card Footers */
  .card-footer-spacer {
    height: 14px;
  }

  .card-disclaimer {
    font-size: 0.7rem;
    color: #8f877f;
    margin-top: 4px;
    line-height: 1.3;
  }

  .bonus-divider {
    width: 75%;
    height: 1px;
    background-color: #e6d2c3;
    margin: 8px auto 6px;
  }

  .bonus-footer-text {
    font-size: 0.72rem;
    color: #7d7268;
    line-height: 1.35;
    max-width: 175px;
  }

  /* Action & Deposit */
  .hero-offer-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .btn-secure-offer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--brand-terracotta, #b85834);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 11px 32px;
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(184, 88, 52, 0.2);
    transition:
      transform 0.2s cubic-bezier(0.2, 0, 0, 1),
      background-color 0.2s ease,
      box-shadow 0.2s ease;
    margin-bottom: 16px;
  }

  .btn-secure-offer:hover {
    background-color: #a04a29;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(184, 88, 52, 0.28);
  }

  .btn-secure-offer:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(184, 88, 52, 0.2);
  }

  .btn-secure-offer svg {
    transition: transform 0.2s ease;
  }

  .btn-secure-offer:hover svg {
    transform: translateX(3px);
  }

  .deposit-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 520px;
  }

  .deposit-headline {
    font-size: clamp(1.45rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    color: var(--text-dark, #181512);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .deposit-copy-primary {
    font-size: 0.86rem;
    color: #2e2823;
    font-weight: 500;
    line-height: 1.45;
  }

  .deposit-copy-secondary {
    font-size: 0.78rem;
    color: #726a62;
    font-weight: 400;
    line-height: 1.45;
    margin-top: 2px;
  }

  .deposit-terms-link {
    font-size: 0.72rem;
    color: #948b81;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    background: none;
    border: none;
    margin-top: 2px;
    padding: 2px 6px;
    transition: color 0.18s ease;
  }

  .deposit-terms-link:hover {
    color: var(--brand-terracotta, #b85834);
  }

  .terms-expandable {
    margin-top: 10px;
    width: 100%;
    animation: fadeInTerms 0.25s ease-out;
  }

  .terms-box {
    background-color: #f5efe6;
    border: 1px solid #e5ded5;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 0.74rem;
    color: #5e564f;
    line-height: 1.45;
    text-align: left;
  }

  @keyframes fadeInTerms {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Breakpoints */
  @media (max-width: 860px) {
    .hero-offer-grid {
      grid-template-columns: 1fr;
      max-width: 340px;
      gap: 14px;
    }

    .offer-card-title {
      min-height: auto;
    }

    .card-footer-spacer {
      display: none;
    }

    .hero-offer-wrapper {
      margin-bottom: 38px;
    }
  }

  @media (max-width: 500px) {
    .offer-card {
      padding: 18px 14px 16px;
    }

    .btn-secure-offer {
      width: 100%;
      max-width: 280px;
      padding: 10px 20px;
      font-size: 0.92rem;
    }

    .deposit-copy-primary,
    .deposit-copy-secondary {
      font-size: 0.8rem;
    }
  }
</style>
