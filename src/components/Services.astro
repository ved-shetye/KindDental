</style>

<script>
  function initServicesSlider() {
    const viewport = document.getElementById('services-slider-viewport') as HTMLElement | null;
    const track = document.getElementById('services-slider-track') as HTMLElement | null;
    const dots = document.querySelectorAll('.services-slider-dot');

    if (!viewport || !track) return;

    let isDown = false;
    let startX = 0;
    let scrollStart = 0;
    let isUserInteracting = false;
    let resumeTimeout: ReturnType<typeof setTimeout> | null = null;
    let animationFrameId: number | null = null;
    let lastTime = performance.now();

    // Very slow, calm ambient speed (16px per second for ultra-gentle movement)
    const speedPerSecond = 16;

    // Cache dimensions to avoid layout thrashing during animation frames
    let halfWidth = track.scrollWidth / 2;
    let cardWidth = 275 + 16;
    let lastDotIndex = -1;

    const measureLayout = () => {
      const firstCard = track.querySelector('.mobile-card') as HTMLElement | null;
      if (firstCard) {
        cardWidth = firstCard.offsetWidth + 16;
      }
      halfWidth = track.scrollWidth / 2;
    };

    // Measure once on init and on window resize
    measureLayout();
    window.addEventListener('resize', measureLayout);

    // High precision floating-point accumulator to prevent integer truncation stutter
    let scrollPos = viewport.scrollLeft;

    const updateActiveDot = () => {
      if (!dots.length || cardWidth <= 0) return;
      const currentScroll = halfWidth > 0 ? (scrollPos % halfWidth) : scrollPos;
      const index = Math.min(4, Math.max(0, Math.floor((currentScroll + cardWidth * 0.3) / cardWidth) % 5));

      if (index !== lastDotIndex) {
        lastDotIndex = index;
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      }
    };

    const step = (now: number) => {
      const dt = Math.min((now - lastTime) / 1000, 0.1); // clamp delta time for stability
      lastTime = now;

      if (window.innerWidth <= 900 && !isUserInteracting) {
        scrollPos += speedPerSecond * dt;

        if (halfWidth > 0 && scrollPos >= halfWidth) {
          scrollPos -= halfWidth;
        }

        viewport.scrollLeft = scrollPos;
        updateActiveDot();
      }

      animationFrameId = requestAnimationFrame(step);
    };

    const pauseInteraction = () => {
      isUserInteracting = true;
      if (resumeTimeout) clearTimeout(resumeTimeout);
      scrollPos = viewport.scrollLeft;
    };

    const resumeInteraction = () => {
      if (resumeTimeout) clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(() => {
        scrollPos = viewport.scrollLeft;
        lastTime = performance.now();
        isUserInteracting = false;
      }, 1500); // 1.5s idle pause after manual touch/swipe before slow auto-slide resumes
    };

    // Manual Mouse Dragging (for desktop browser resizing / testing)
    viewport.addEventListener('mousedown', (e) => {
      isDown = true;
      viewport.classList.add('is-dragging');
      pauseInteraction();
      startX = e.pageX;
      scrollStart = viewport.scrollLeft;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const dx = e.pageX - startX;
      scrollPos = scrollStart - dx;

      if (halfWidth > 0) {
        if (scrollPos >= halfWidth) {
          scrollPos -= halfWidth;
          scrollStart -= halfWidth;
        } else if (scrollPos <= 0) {
          scrollPos += halfWidth;
          scrollStart += halfWidth;
        }
      }
      viewport.scrollLeft = scrollPos;
      updateActiveDot();
    });

    const stopDrag = () => {
      if (!isDown) return;
      isDown = false;
      viewport.classList.remove('is-dragging');
      resumeInteraction();
    };

    window.addEventListener('mouseup', stopDrag);

    // Native Touch events for mobile devices
    viewport.addEventListener('touchstart', pauseInteraction, { passive: true });
    viewport.addEventListener('touchend', resumeInteraction, { passive: true });
    viewport.addEventListener('touchcancel', resumeInteraction, { passive: true });

    // Handle native mobile momentum scroll and infinite wrap
    viewport.addEventListener('scroll', () => {
      if (isUserInteracting) {
        scrollPos = viewport.scrollLeft;
        if (halfWidth > 0) {
          if (scrollPos >= halfWidth) {
            scrollPos -= halfWidth;
            viewport.scrollLeft = scrollPos;
          } else if (scrollPos <= 0) {
            scrollPos += halfWidth;
            viewport.scrollLeft = scrollPos;
          }
        }
        updateActiveDot();
      }
    }, { passive: true });

    // Dot navigation buttons
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        pauseInteraction();
        scrollPos = idx * cardWidth;
        viewport.scrollTo({
          left: scrollPos,
          behavior: 'smooth'
        });
        resumeInteraction();
      });
    });

    // Pause on hover
    viewport.addEventListener('mouseenter', pauseInteraction);
    viewport.addEventListener('mouseleave', resumeInteraction);

    // Start auto-movement loop
    lastTime = performance.now();
    if (!animationFrameId) {
      animationFrameId = requestAnimationFrame(step);
    }
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServicesSlider);
  } else {
    initServicesSlider();
  }
</script>
