<section class="services-section" id="services">
  <div class="container">
    <div class="section-title-wrapper">
      <h2 class="section-heading font-serif">Here's what we do 🦷</h2>
      <!-- Yellow Wavy Underline -->
      <svg
        class="wavy-underline"
        viewBox="0 0 140 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 3 8 Q 25 1, 48 8 T 92 8 T 136 8"
          stroke="#F4BF3A"
          stroke-width="4.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <!-- Row 1: 3 Cards (Desktop View) -->
    <div class="services-grid-top desktop-only">
      <!-- Card 1: Oral Hygiene & Prevention (Yellow on hover) -->
      <article class="service-card editorial-card card-yellow" tabindex="0">
        <div class="card-icon-area">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Smile arc with bubble -->
            <path
              d="M 18 36 C 24 46, 40 46, 46 36"
              stroke="#181512"
              stroke-width="3"
              stroke-linecap="round"></path>
            <circle cx="32" cy="22" r="3.5" fill="#181512"></circle>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Oral Hygiene & Prevention</h3>
          <p class="service-desc">
            AirPolish hygiene therapy and prevention-first care to keep your
            mouth healthy.
          </p>
        </div>
      </article>

      <!-- Card 2: AI Dental Report & Your Kind Dental Score (Blue on hover) -->
      <article class="service-card editorial-card card-blue" tabindex="0">
        <div class="card-icon-area">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Document with clock -->
            <rect
              x="18"
              y="14"
              width="28"
              height="36"
              rx="4"
              stroke="#181512"
              stroke-width="3"></rect>
            <line
              x1="24"
              y1="22"
              x2="38"
              y2="22"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></line>
            <line
              x1="24"
              y1="28"
              x2="38"
              y2="28"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></line>
            <!-- Clock on bottom right -->
            <circle
              cx="44"
              cy="44"
              r="8"
              fill="#FAF7F2"
              stroke="#181512"
              stroke-width="2.5"></circle>
            <polyline
              points="44 40 44 44 47 44"
              stroke="#181512"
              stroke-width="2"
              stroke-linecap="round"></polyline>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">
            AI Dental Report & Your Kind Dental Score
          </h3>
          <p class="service-desc">
            Digital scans and AI-supported monitoring, that you can access with
            a personal score for you keep track of your oral health.
          </p>
        </div>
      </article>

      <!-- Card 3: Kids Dental Exams (Orange on hover) -->
      <article class="service-card editorial-card card-orange" tabindex="0">
        <div class="card-icon-area">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Cute Child / Face outline with curl -->
            <circle cx="32" cy="34" r="14" stroke="#181512" stroke-width="3"
            ></circle>
            <path
              d="M 32 20 C 30 14, 38 12, 36 20"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="27" cy="33" r="1.8" fill="#181512"></circle>
            <circle cx="37" cy="33" r="1.8" fill="#181512"></circle>
            <path
              d="M 28 39 Q 32 43 36 39"
              stroke="#181512"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Kids Dental Exams</h3>
          <p class="service-desc">
            Gentle, friendly check-ups that build healthy habits early — and
            make seeing the dentist feel good and routine.
          </p>
        </div>
      </article>
    </div>

    <!-- Middle Video Embed (3 cards above, image/video embed, 2 cards below) -->
    <div class="services-media-wrapper">
      <div
        class="services-video-card"
        id="services-video-btn"
        data-open-video="true"
        role="button"
        tabindex="0"
        aria-label="Play Kind Dental story video"
