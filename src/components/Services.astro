  }

  .service-card.card-orange:hover .card-icon-area,
  .service-card.card-orange:focus-visible .card-icon-area,
  .service-card.card-orange:focus-within .card-icon-area {
    background-color: var(--brand-orange);
  }

  .service-card.card-purple:hover .card-icon-area,
  .service-card.card-purple:focus-visible .card-icon-area,
  .service-card.card-purple:focus-within .card-icon-area {
