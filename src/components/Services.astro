              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="20" cy="18" r="2.2" fill="#181512"></circle>
          </svg>
        </div>

        <!-- Bottom-right custom arch corner mark from video -->
        <div class="corner-mark bottom-right">
          <svg
            viewBox="0 0 40 40"
            width="36"
            height="36"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M 8 16 C 12 28, 28 28, 32 16"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="15" cy="22" r="1.5" fill="#181512"></circle>
            <circle cx="25" cy="22" r="1.5" fill="#181512"></circle>
          </svg>
        </div>

        <!-- Center Interactive Play Button -->
        <div class="play-button-circle">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="#181512"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M 8 5 V 19 L 19 12 Z"></path>
          </svg>
        </div>

        <!-- Floating Badge -->
        <div class="services-video-badge">
          <span class="live-dot"></span>
          <span>INSIDE KIND DENTAL · JANE'S STORY</span>
        </div>

        <div class="video-overlay-hint">
          <span>Click to watch the experience</span>
        </div>
      </div>

      <!-- Mid Quote Banner -->
      <div class="services-quote-banner">
        <p class="quote-text font-sans">
          Healthy habits from the start, for <strong
            >lifelong healthy teeth</strong
