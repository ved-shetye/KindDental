---

---

<section class="services-section" id="services">
  <div class="container">
    <div class="section-title-wrapper">
      <h2 class="section-heading font-serif">Here's what we do 🦷</h2>
      <!-- Yellow Wavy Underline -->
      <svg
        class="wavy-underline"
        viewBox="0 0 140 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M 3 8 Q 25 1, 48 8 T 92 8 T 136 8"
          stroke="#F4BF3A"
          stroke-width="4.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <!-- Row 1: 3 Cards -->
    <div class="services-grid-top">
      <!-- Card 1: Oral Hygiene & Prevention -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-cream">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Smile arc with bubble -->
            <path
              d="M 18 36 C 24 46, 40 46, 46 36"
              stroke="#181512"
              stroke-width="3"
              stroke-linecap="round"></path>
            <circle cx="32" cy="22" r="3.5" fill="#181512"></circle>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Oral Hygiene & Prevention</h3>
          <p class="service-desc">
            AirPolish hygiene therapy and prevention-first care to keep your
            mouth healthy.
          </p>
        </div>
      </article>

      <!-- Card 2: AI Dental Report & Your Kind Dental Score -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-cream">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Document with clock -->
            <rect
              x="18"
              y="14"
              width="28"
              height="36"
              rx="4"
              stroke="#181512"
              stroke-width="3"></rect>
            <line
              x1="24"
              y1="22"
              x2="38"
              y2="22"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></line>
            <line
              x1="24"
              y1="28"
              x2="38"
              y2="28"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></line>
            <!-- Clock on bottom right -->
            <circle
              cx="44"
              cy="44"
              r="8"
              fill="#FAF7F2"
              stroke="#181512"
              stroke-width="2.5"></circle>
            <polyline
              points="44 40 44 44 47 44"
              stroke="#181512"
              stroke-width="2"
              stroke-linecap="round"></polyline>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">
            AI Dental Report & Your Kind Dental Score
          </h3>
          <p class="service-desc">
            Digital scans and AI-supported monitoring, that you can access with
            a personal score for you keep track of your oral health.
          </p>
        </div>
      </article>

      <!-- Card 3: Kids Dental Exams (Coral banner) -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-coral">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Cute Child / Face outline with curl -->
            <circle cx="32" cy="34" r="14" stroke="#181512" stroke-width="3"
            ></circle>
            <path
              d="M 32 20 C 30 14, 38 12, 36 20"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="27" cy="33" r="1.8" fill="#181512"></circle>
            <circle cx="37" cy="33" r="1.8" fill="#181512"></circle>
            <path
              d="M 28 39 Q 32 43 36 39"
              stroke="#181512"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Kids Dental Exams</h3>
          <p class="service-desc">
            Gentle, friendly check-ups that build healthy habits early — and
            make seeing the dentist feel good and routine.
          </p>
        </div>
      </article>
    </div>

    <!-- Middle Video Embed (3 cards above, image/video embed, 2 cards below) -->
    <div class="services-media-wrapper">
      <div
        class="services-video-card"
        id="services-video-btn"
        data-open-video="true"
        role="button"
        tabindex="0"
        aria-label="Play Kind Dental story video"
      >
        <img
          src="/jane-story.jpg"
          alt="Kind Dental Studio Experience with Jane"
          class="services-video-img"
          loading="lazy"
        />

        <div class="video-card-overlay"></div>

        <!-- Top-left custom arch corner mark from video -->
        <div class="corner-mark top-left">
          <svg
            viewBox="0 0 40 40"
            width="36"
            height="36"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M 8 28 C 12 12, 28 12, 32 28"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="20" cy="18" r="2.2" fill="#181512"></circle>
          </svg>
        </div>

        <!-- Bottom-right custom arch corner mark from video -->
        <div class="corner-mark bottom-right">
          <svg
            viewBox="0 0 40 40"
            width="36"
            height="36"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M 8 16 C 12 28, 28 28, 32 16"
              stroke="#181512"
              stroke-width="2.5"
              stroke-linecap="round"></path>
            <circle cx="15" cy="22" r="1.5" fill="#181512"></circle>
            <circle cx="25" cy="22" r="1.5" fill="#181512"></circle>
          </svg>
        </div>

        <!-- Center Interactive Play Button -->
        <div class="play-button-circle">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="#181512"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M 8 5 V 19 L 19 12 Z"></path>
          </svg>
        </div>

        <!-- Floating Badge -->
        <div class="services-video-badge">
          <span class="live-dot"></span>
          <span>INSIDE KIND DENTAL · JANE'S STORY</span>
        </div>

        <div class="video-overlay-hint">
          <span>Click to watch the experience</span>
        </div>
      </div>

      <!-- Mid Quote Banner -->
      <div class="services-quote-banner">
        <p class="quote-text font-sans">
          Healthy habits from the start, for <strong
            >lifelong healthy teeth</strong
          >.
        </p>
      </div>
    </div>

    <!-- Row 2: 2 Cards Centered -->
    <div class="services-grid-bottom">
      <!-- Card 4: Teeth Straightening (Lavender banner) -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-purple">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Double arrow <-> -->
            <line
              x1="18"
              y1="32"
              x2="46"
              y2="32"
              stroke="#181512"
              stroke-width="3"
              stroke-linecap="round"></line>
            <polyline
              points="26 24 18 32 26 40"
              stroke="#181512"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></polyline>
            <polyline
              points="38 24 46 32 38 40"
              stroke="#181512"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></polyline>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Teeth Straightening</h3>
          <p class="service-desc">
            Clear aligners and fixed braces for adults and kids — straighter
            long lasting natural smiles.
          </p>
        </div>
      </article>

      <!-- Card 5: Teeth Whitening -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-cream">
          <svg
            class="service-svg-icon"
            viewBox="0 0 64 64"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Tooth with sparkle -->
            <path
              d="M 22 28 C 22 20, 42 20, 42 28 C 42 38, 38 46, 32 46 C 26 46, 22 38, 22 28 Z"
              stroke="#181512"
              stroke-width="2.5"
              fill="none"></path>
            <!-- Sparkle top right -->
            <path
              d="M 46 16 L 47.5 20.5 L 52 22 L 47.5 23.5 L 46 28 L 44.5 23.5 L 40 22 L 44.5 20.5 Z"
              fill="#181512"></path>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Teeth Whitening</h3>
          <p class="service-desc">
            Safe, effective whitening to bring your natural smile back to its
            brightest.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 20px 0;
    background-color: var(--bg-page);
  }

  .section-title-wrapper {
    text-align: center;
    margin-bottom: 50px;
  }

  .services-grid-top {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 36px;
  }

  /* Middle Video Embed */
  .services-media-wrapper {
    max-width: 780px;
    margin: 44px auto 44px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .services-video-card {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.5;
    max-height: 420px;
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: 4px 4px 0px var(--border-ink);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #faf7f2;
    transition:
      transform 0.22s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.22s ease;
  }

  .services-video-card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0px var(--border-ink);
  }

  .services-video-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .services-video-card:hover .services-video-img {
    transform: scale(1.03);
  }

  .video-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(24, 21, 18, 0.12) 0%,
      rgba(24, 21, 18, 0.35) 100%
    );
    transition: background 0.25s ease;
    pointer-events: none;
    z-index: 1;
  }

  .services-video-card:hover .video-card-overlay {
    background: linear-gradient(
      180deg,
      rgba(24, 21, 18, 0.08) 0%,
      rgba(24, 21, 18, 0.22) 100%
    );
  }

  .corner-mark {
    position: absolute;
    pointer-events: none;
    z-index: 2;
  }

  .corner-mark.top-left {
    top: 18px;
    left: 20px;
  }

  .corner-mark.bottom-right {
    bottom: 16px;
    right: 20px;
  }

  .play-button-circle {
    position: relative;
    z-index: 3;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: #ffffff;
    border: var(--border-width) solid var(--border-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    padding-left: 3px;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .services-video-card:hover .play-button-circle {
    transform: scale(1.12);
    background-color: var(--brand-yellow);
  }

  .services-video-badge {
    position: absolute;
    top: 18px;
    left: 20px;
    background: rgba(24, 21, 18, 0.85);
    backdrop-filter: blur(6px);
    color: #faf7f2;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #e25e4b;
    animation: pulseDot 1.8s infinite;
  }

  @keyframes pulseDot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .video-overlay-hint {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(24, 21, 18, 0.8);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    letter-spacing: 0.03em;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    z-index: 3;
  }

  .services-video-card:hover .video-overlay-hint {
    opacity: 1;
  }

  .services-quote-banner {
    text-align: center;
    margin: 28px auto 0;
    padding: 12px 20px;
  }

  .quote-text {
    font-size: 1.05rem;
    color: var(--text-dark);
  }

  .quote-text strong {
    font-weight: 700;
  }

  .services-grid-bottom {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    max-width: 780px;
    margin: 0 auto;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #faf7f2;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .card-icon-area {
    height: 126px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: var(--border-width) solid var(--border-ink);
    transition: background-color 0.2s ease;
  }

  .card-icon-area.bg-cream {
    background-color: #efe9df;
  }

  .service-card:hover .card-icon-area.bg-cream {
    background-color: #e6dece;
  }

  .card-icon-area.bg-coral {
    background-color: var(--brand-coral);
  }

  .card-icon-area.bg-purple {
    background-color: var(--brand-purple);
  }

  .service-svg-icon {
    width: 52px;
    height: 52px;
  }

  .card-content-area {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .service-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-dark);
    margin-bottom: 12px;
  }

  .service-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .section-title-wrapper {
      margin-bottom: 24px;
    }
    .services-grid-top {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 18px;
    }
    .services-grid-bottom {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .services-media-wrapper {
      margin: 18px auto 20px;
    }
    .services-video-card {
      aspect-ratio: 16 / 10;
    }
    .play-button-circle {
      width: 60px;
      height: 60px;
    }
    .services-video-badge {
      font-size: 0.65rem;
      padding: 5px 12px;
      top: 14px;
      left: 14px;
    }
    .corner-mark.top-left {
      top: 12px;
      left: 12px;
      transform: scale(0.85);
    }
    .corner-mark.bottom-right {
      bottom: 12px;
      right: 12px;
      transform: scale(0.85);
    }
  }
</style>
