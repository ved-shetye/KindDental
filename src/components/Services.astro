    background-color: #efe9df;
    transition: background-color 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  /* Hover color states: yellow, blue, orange, purple, green */
  .service-card.card-yellow:hover .card-icon-area,
  .service-card.card-yellow:focus-visible .card-icon-area,
  .service-card.card-yellow:focus-within .card-icon-area {
