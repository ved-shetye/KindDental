  }

  /* Visibility Helpers */
  .desktop-only {
    display: grid;
  }

  .mobile-only {
    display: none !important;
  }

  @media (max-width: 900px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: block !important;
    }

    .section-title-wrapper {
      margin-bottom: 20px;
    }

    /* Video Embed is first on mobile, placed nicely below title */
    .services-media-wrapper {
      margin: 12px auto 24px;
      width: 100%;
    }

    .services-video-card {
      aspect-ratio: 16 / 10;
    }

    .play-button-circle {
      width: 60px;
      height: 60px;
    }

    .services-video-badge {
      font-size: 0.65rem;
      padding: 5px 12px;
      top: 14px;
      left: 14px;
    }

    .corner-mark.top-left {
      top: 12px;
      left: 12px;
      transform: scale(0.85);
    }

    .corner-mark.bottom-right {
      bottom: 12px;
      right: 12px;
      transform: scale(0.85);
    }

    /* Mobile Slider Container (One card at a time with swipe & auto 5s progression) */
    .services-mobile-slider {
      width: 100%;
      max-width: 380px;
      margin: 8px auto 20px;
      position: relative;
    }

    .slider-viewport {
      width: 100%;
      overflow: hidden;
      cursor: grab;
      touch-action: pan-y;
      padding: 6px 6px 14px 6px;
      margin: -6px -6px -14px -6px;
      user-select: none;
      -webkit-user-select: none;
    }

    .slider-viewport.is-dragging {
      cursor: grabbing;
