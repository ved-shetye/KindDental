    .slider-slide {
      width: 100%;
      min-width: 100%;
      max-width: 100%;
      flex-shrink: 0;
      box-sizing: border-box;
      padding: 0 10px;
    }

    .mobile-card {
      width: 100%;
      border: var(--border-width) solid var(--border-ink);
      border-radius: var(--radius-xl);
      box-shadow: 4px 4px 0px var(--border-ink);
      background-color: #faf7f2;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .mobile-card:active {
      transform: scale(0.99);
    }

    /* On mobile, cards have their brand color on top icon area */
    .mobile-card.card-yellow .card-icon-area {
      background-color: var(--brand-yellow) !important;
    }

    .mobile-card.card-blue .card-icon-area {
      background-color: var(--brand-blue) !important;
    }

    .mobile-card.card-orange .card-icon-area {
      background-color: var(--brand-orange) !important;
    }

    .mobile-card.card-purple .card-icon-area {
      background-color: var(--brand-purple) !important;
    }

    .mobile-card.card-green .card-icon-area {
      background-color: var(--brand-green) !important;
    }

    .mobile-card .card-icon-area {
      height: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: var(--border-width) solid var(--border-ink);
      transition: background-color 0.25s ease;
    }

    .mobile-card .service-svg-icon {
      width: 52px;
      height: 52px;
    }

    .mobile-card .card-content-area {
      padding: 20px 20px 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 140px;
    }

    .service-slide-tag {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .mobile-card .service-title {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 8px;
      line-height: 1.25;
      color: var(--text-dark);
    }

    .mobile-card .service-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Navigation Controls Bar (Arrows + Dots) */
    .slider-controls-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-top: 14px;
    }

    .slider-arrow-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: var(--border-width) solid var(--border-ink);
      background-color: #faf7f2;
      box-shadow: 2.5px 2.5px 0px var(--border-ink);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dark);
      cursor: pointer;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        background-color 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .slider-arrow-btn:hover {
      background-color: var(--brand-yellow);
      transform: translateY(-1px);
      box-shadow: 3.5px 3.5px 0px var(--border-ink);
    }

    .slider-arrow-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 0.5px 0.5px 0px var(--border-ink);
    }

    /* Slider Dots Indicator */
    .slider-dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .services-slider-dot {
      width: 9px;
      height: 9px;
      border-radius: var(--radius-full);
      background-color: #dfd7cb;
      border: 1.5px solid var(--border-ink);
      padding: 0;
      cursor: pointer;
      transition: all 0.28s cubic-bezier(0.2, 0, 0, 1);
      -webkit-tap-highlight-color: transparent;
    }

    .services-slider-dot.active {
      width: 26px;
      background-color: var(--border-ink);
    }

    /* Swipe / Drag & Auto-timer Status Hint */
    .slider-swipe-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-top: 10px;
    }

    .slider-counter-badge {
      font-family: var(--font-sans);
      font-weight: 700;
      background: var(--bg-card);
      border: 1px solid var(--border-ink);
      padding: 2px 8px;
      border-radius: var(--radius-full);
      color: var(--text-dark);
      letter-spacing: 0.05em;
    }

    .hint-divider {
      color: #b5ada3;
    }

    .timer-pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--brand-terracotta);
      animation: pulseTimer 2s infinite;
    }

    @keyframes pulseTimer {
      0%,
      100% {
        opacity: 0.35;
        transform: scale(0.9);
      }
      50% {
        opacity: 1;
        transform: scale(1.2);
      }
    }
  }
</style>

<script>
  function initServicesSlider() {
    const container = document.getElementById(
      "services-mobile-carousel",
    ) as HTMLElement | null;
    const viewport = document.getElementById(
      "services-slider-viewport",
    ) as HTMLElement | null;
    const track = document.getElementById(
      "services-slider-track",
    ) as HTMLElement | null;
    const prevBtn = document.getElementById(
      "services-prev-btn",
    ) as HTMLElement | null;
    const nextBtn = document.getElementById(
      "services-next-btn",
    ) as HTMLElement | null;
    const counter = document.getElementById(
      "services-slider-counter",
    ) as HTMLElement | null;
    const dots = document.querySelectorAll(
      ".services-slider-dot",
    ) as NodeListOf<HTMLElement>;

    if (!container || !viewport || !track) return;

    // Prevent duplicate initialization
    if (track.getAttribute("data-slider-ready") === "true") return;
    track.setAttribute("data-slider-ready", "true");

    const originalSlides = Array.from(
      track.querySelectorAll(".slider-slide"),
    ) as HTMLElement[];
    const totalOriginal = originalSlides.length; // 5
    if (totalOriginal === 0) return;

    // Setup clones for seamless infinite looping
    const cloneLast = originalSlides[totalOriginal - 1].cloneNode(
      true,
    ) as HTMLElement;
    cloneLast.setAttribute("aria-hidden", "true");
    cloneLast.classList.add("slider-clone");

    const cloneFirst = originalSlides[0].cloneNode(true) as HTMLElement;
    cloneFirst.setAttribute("aria-hidden", "true");
    cloneFirst.classList.add("slider-clone");

    track.insertBefore(cloneLast, track.firstChild);
    track.appendChild(cloneFirst);

    // Index 1 corresponds to first real slide (Card 0)
    let currentIndex = 1;
    const totalWithClones = totalOriginal + 2; // 7

    let isAnimating = false;
    let isDragging = false;
    let isHorizontalSwipe: boolean | null = null;
    let startX = 0;
    let startY = 0;
    let currentTranslateX = 0;
    let viewportWidth = viewport.offsetWidth || 360;

    // 5-second automatic progression
    const AUTO_INTERVAL = 5000;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    let isPaused = false;

    const updateUI = (index: number) => {
      // Map 1..5 to 0..4
      const realIndex = (index - 1 + totalOriginal) % totalOriginal;

      dots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === realIndex);
      });

      if (counter) {
        counter.textContent = `0${realIndex + 1} / 0${totalOriginal}`;
      }
    };

    const setPositionByIndex = (index: number, animate = true) => {
      if (animate) {
        track.style.transition =
          "transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)";
      } else {
        track.style.transition = "none";
      }
      track.style.transform = `translate3d(-${index * 100}%, 0, 0)`;
    };

    const goToSlide = (targetIndex: number, animate = true) => {
      if (isAnimating && animate) return;

      if (animate) {
        isAnimating = true;
      }
      currentIndex = targetIndex;
      setPositionByIndex(currentIndex, animate);
      updateUI(currentIndex);
      resetAutoSlide();
    };

    const nextSlide = () => {
      goToSlide(currentIndex + 1, true);
    };

    const prevSlide = () => {
      goToSlide(currentIndex - 1, true);
    };

    // Seamless loop wrapping on animation completion
    track.addEventListener("transitionend", (e) => {
      if (e.target !== track) return;
      isAnimating = false;

      // Reached clone of first slide (at end)
      if (currentIndex >= totalWithClones - 1) {
        track.style.transition = "none";
        currentIndex = 1;
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;
        void track.offsetWidth; // Force reflow
      }
      // Reached clone of last slide (at start)
      else if (currentIndex <= 0) {
        track.style.transition = "none";
        currentIndex = totalOriginal;
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;
        void track.offsetWidth; // Force reflow
      }
    });

    // Auto-slide 5s timer
    const startAutoSlide = () => {
      stopAutoSlide();
      autoTimer = setInterval(() => {
        if (window.innerWidth <= 900 && !isPaused && !isDragging) {
          nextSlide();
        }
      }, AUTO_INTERVAL);
    };

    const stopAutoSlide = () => {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    };

    const resetAutoSlide = () => {
      stopAutoSlide();
      startAutoSlide();
    };

    // Drag / Touch event handlers
    const onDragStart = (clientX: number, clientY: number) => {
      if (isAnimating) return;
      isDragging = true;
      isHorizontalSwipe = null;
      startX = clientX;
      startY = clientY;
      viewportWidth = viewport.offsetWidth || 360;
      currentTranslateX = -currentIndex * viewportWidth;
      track.style.transition = "none";
      viewport.classList.add("is-dragging");
      stopAutoSlide();
    };

    const onDragMove = (clientX: number, clientY: number, e: Event) => {
      if (!isDragging) return;

      const dx = clientX - startX;
      const dy = clientY - startY;

      // Determine horizontal swipe vs vertical scroll
      if (isHorizontalSwipe === null) {
        if (Math.abs(dx) > 6 || Math.abs(dy) > 6) {
          if (Math.abs(dx) > Math.abs(dy)) {
            isHorizontalSwipe = true;
          } else {
            // Natural vertical scroll, don't interfere
            isHorizontalSwipe = false;
            isDragging = false;
            viewport.classList.remove("is-dragging");
            resetAutoSlide();
            return;
          }
        }
      }

      if (isHorizontalSwipe) {
        if (e.cancelable) e.preventDefault();
        const newTranslate = currentTranslateX + dx;
        track.style.transform = `translate3d(${newTranslate}px, 0, 0)`;
      }
    };

    const onDragEnd = (clientX: number) => {
      if (!isDragging) return;
      isDragging = false;
      viewport.classList.remove("is-dragging");

      if (isHorizontalSwipe) {
        const dx = clientX - startX;
        const threshold = 40; // 40px drag threshold

        if (dx < -threshold) {
          goToSlide(currentIndex + 1, true);
        } else if (dx > threshold) {
          goToSlide(currentIndex - 1, true);
        } else {
          goToSlide(currentIndex, true);
        }
      } else {
        goToSlide(currentIndex, true);
      }

      resetAutoSlide();
    };

    // Touch listeners
    viewport.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        if (e.touches.length === 1) {
          onDragStart(e.touches[0].clientX, e.touches[0].clientY);
        }
      },
      { passive: true },
    );

    viewport.addEventListener(
      "touchmove",
      (e: TouchEvent) => {
        if (e.touches.length === 1) {
          onDragMove(e.touches[0].clientX, e.touches[0].clientY, e);
        }
      },
      { passive: false },
    );

    viewport.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        if (e.changedTouches.length === 1) {
          onDragEnd(e.changedTouches[0].clientX);
        }
      },
      { passive: true },
    );

    viewport.addEventListener(
      "touchcancel",
      () => {
        if (isDragging) {
          isDragging = false;
          viewport.classList.remove("is-dragging");
          goToSlide(currentIndex, true);
          resetAutoSlide();
        }
      },
      { passive: true },
    );

    // Mouse listeners (for desktop inspection / dragging)
    let lastMouseX = 0;
    viewport.addEventListener("mousedown", (e: MouseEvent) => {
      e.preventDefault();
      lastMouseX = e.clientX;
      onDragStart(e.clientX, e.clientY);
    });

    window.addEventListener("mousemove", (e: MouseEvent) => {
      if (!isDragging) return;
      lastMouseX = e.clientX;
      onDragMove(e.clientX, e.clientY, e);
    });

    window.addEventListener("mouseup", () => {
      if (isDragging) {
        onDragEnd(lastMouseX);
      }
    });

    // Arrow button controls
    if (prevBtn) {
      prevBtn.addEventListener("click", (e) => {
        e.preventDefault();
        prevSlide();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", (e) => {
        e.preventDefault();
        nextSlide();
      });
    }

    // Dot indicators click
    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        e.preventDefault();
        const dotIndex = parseInt(dot.getAttribute("data-index") || "0", 10);
        goToSlide(dotIndex + 1, true);
      });
    });

    // Pause on hover
    container.addEventListener("mouseenter", () => {
      isPaused = true;
    });

    container.addEventListener("mouseleave", () => {
      isPaused = false;
      resetAutoSlide();
    });

    // Pause when tab hidden
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoSlide();
      } else {
        resetAutoSlide();
      }
    });

    // IntersectionObserver to pause when offscreen
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              isPaused = false;
              resetAutoSlide();
            } else {
              isPaused = true;
              stopAutoSlide();
            }
          });
        },
        { threshold: 0.15 },
      );
      observer.observe(container);
    }

    // Keep correct slide alignment on window resize
    window.addEventListener("resize", () => {
      viewportWidth = viewport.offsetWidth || 360;
      if (!isDragging) {
        setPositionByIndex(currentIndex, false);
      }
    });

    // Initial setup
    setPositionByIndex(currentIndex, false);
    updateUI(currentIndex);

    // Launch the 5-second auto progression
    startAutoSlide();
  }

  // Initialize on DOM ready & View Transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServicesSlider);
  } else {
    initServicesSlider();
  }
  document.addEventListener("astro:page-load", initServicesSlider);
</script>
