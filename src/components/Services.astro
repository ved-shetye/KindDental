---
---

<section class="services-section" id="services">
  <div class="container">
    <div class="section-title-wrapper">
      <h2 class="section-heading font-serif">Here's what we do 🦷</h2>
      <!-- Yellow Wavy Underline -->
      <svg class="wavy-underline" viewBox="0 0 140 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M 3 8 Q 25 1, 48 8 T 92 8 T 136 8" stroke="#F4BF3A" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Row 1: 3 Cards -->
    <div class="services-grid-top">
      <!-- Card 1: Oral Hygiene & Prevention -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-cream">
          <svg class="service-svg-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Smile arc with bubble -->
            <path d="M 18 36 C 24 46, 40 46, 46 36" stroke="#181512" stroke-width="3" stroke-linecap="round"/>
            <circle cx="32" cy="22" r="3.5" fill="#181512"/>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Oral Hygiene & Prevention</h3>
          <p class="service-desc">
            AirFlow hygiene therapy and prevention-first care to keep you healthy, not just fix problems when they show up.
          </p>
        </div>
      </article>

      <!-- Card 2: AI Dental Report & Your Kind Dental Score -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-cream">
          <svg class="service-svg-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Document with clock -->
            <rect x="18" y="14" width="28" height="36" rx="4" stroke="#181512" stroke-width="3"/>
            <line x1="24" y1="22" x2="38" y2="22" stroke="#181512" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="24" y1="28" x2="38" y2="28" stroke="#181512" stroke-width="2.5" stroke-linecap="round"/>
            <!-- Clock on bottom right -->
            <circle cx="44" cy="44" r="8" fill="#FAF7F2" stroke="#181512" stroke-width="2.5"/>
            <polyline points="44 40 44 44 47 44" stroke="#181512" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">AI Dental Report & Your Kind Dental Score</h3>
          <p class="service-desc">
            Digital scans and AI-supported monitoring, turned into a personal score out of 10 you can actually understand.
          </p>
        </div>
      </article>

      <!-- Card 3: Kids Dental Exams (Coral banner) -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-coral">
          <svg class="service-svg-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Cute Child / Face outline with curl -->
            <circle cx="32" cy="34" r="14" stroke="#181512" stroke-width="3"/>
            <path d="M 32 20 C 30 14, 38 12, 36 20" stroke="#181512" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="27" cy="33" r="1.8" fill="#181512"/>
            <circle cx="37" cy="33" r="1.8" fill="#181512"/>
            <path d="M 28 39 Q 32 43 36 39" stroke="#181512" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Kids Dental Exams</h3>
          <p class="service-desc">
            Gentle, friendly check-ups that build healthy habits early — and take the fear out of the dentist for good.
          </p>
        </div>
      </article>
    </div>

    <!-- Mid Quote Banner -->
    <div class="services-quote-banner">
      <p class="quote-text font-sans">
        Healthy habits from the start, for <strong>lifelong healthy teeth</strong>.
      </p>
    </div>

    <!-- Row 2: 2 Cards Centered -->
    <div class="services-grid-bottom">
      <!-- Card 4: Teeth Straightening (Lavender banner) -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-purple">
          <svg class="service-svg-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Double arrow <-> -->
            <line x1="18" y1="32" x2="46" y2="32" stroke="#181512" stroke-width="3" stroke-linecap="round"/>
            <polyline points="26 24 18 32 26 40" stroke="#181512" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="38 24 46 32 38 40" stroke="#181512" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Teeth Straightening</h3>
          <p class="service-desc">
            Clear aligner treatment for adults and kids — straighter smiles without the metal-mouth look.
          </p>
        </div>
      </article>

      <!-- Card 5: Teeth Whitening -->
      <article class="service-card editorial-card">
        <div class="card-icon-area bg-cream">
          <svg class="service-svg-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Tooth with sparkle -->
            <path d="M 22 28 C 22 20, 42 20, 42 28 C 42 38, 38 46, 32 46 C 26 46, 22 38, 22 28 Z" stroke="#181512" stroke-width="2.5" fill="none"/>
            <!-- Sparkle top right -->
            <path d="M 46 16 L 47.5 20.5 L 52 22 L 47.5 23.5 L 46 28 L 44.5 23.5 L 40 22 L 44.5 20.5 Z" fill="#181512"/>
          </svg>
        </div>
        <div class="card-content-area">
          <h3 class="service-title font-serif">Teeth Whitening</h3>
          <p class="service-desc">
            Safe, effective whitening to bring your natural smile back to its brightest.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 80px 0;
    background-color: var(--bg-page);
  }

  .section-title-wrapper {
    text-align: center;
    margin-bottom: 50px;
  }

  .services-grid-top {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 36px;
  }

  .services-quote-banner {
    text-align: center;
    margin: 32px auto 44px;
    padding: 12px 20px;
  }

  .quote-text {
    font-size: 1.05rem;
    color: var(--text-dark);
  }

  .quote-text strong {
    font-weight: 700;
  }

  .services-grid-bottom {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    max-width: 780px;
    margin: 0 auto;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #FAF7F2;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .card-icon-area {
    height: 126px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: var(--border-width) solid var(--border-ink);
    transition: background-color 0.2s ease;
  }

  .card-icon-area.bg-cream {
    background-color: #EFE9DF;
  }

  .service-card:hover .card-icon-area.bg-cream {
    background-color: #E6DECE;
  }

  .card-icon-area.bg-coral {
    background-color: var(--brand-coral);
  }

  .card-icon-area.bg-purple {
    background-color: var(--brand-purple);
  }

  .service-svg-icon {
    width: 52px;
    height: 52px;
  }

  .card-content-area {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .service-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-dark);
    margin-bottom: 12px;
  }

  .service-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .services-grid-top {
      grid-template-columns: 1fr;
    }
    .services-grid-bottom {
      grid-template-columns: 1fr;
    }
  }
</style>
