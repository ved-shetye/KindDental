<style>
  .services-section {
    padding: 20px 0;
    background-color: var(--bg-page);
  }

  .section-title-wrapper {
    text-align: center;
    margin-bottom: 50px;
  }

  .services-grid-top {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 36px;
  }

  /* Middle Video Embed */
  .services-media-wrapper {
    max-width: 780px;
    margin: 44px auto 44px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .services-video-card {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.5;
    max-height: 420px;
    border: var(--border-width) solid var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: 4px 4px 0px var(--border-ink);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #faf7f2;
    transition:
      transform 0.22s cubic-bezier(0.2, 0, 0, 1),
      box-shadow 0.22s ease;
  }

  .services-video-card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0px var(--border-ink);
  }

  .services-video-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .services-video-card:hover .services-video-img {
    transform: scale(1.03);
  }

  .video-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(24, 21, 18, 0.12) 0%,
      rgba(24, 21, 18, 0.35) 100%
    );
    transition: background 0.25s ease;
    pointer-events: none;
    z-index: 1;
  }

  .services-video-card:hover .video-card-overlay {
    background: linear-gradient(
      180deg,
      rgba(24, 21, 18, 0.08) 0%,
      rgba(24, 21, 18, 0.22) 100%
    );
  }

  .corner-mark {
    position: absolute;
    pointer-events: none;
    z-index: 2;
  }

  .corner-mark.top-left {
    top: 18px;
