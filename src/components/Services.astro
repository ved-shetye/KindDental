  }

  .service-card:hover,
  .service-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    outline: none;
  }

  .card-icon-area {
    height: 126px;
    display: flex;
    align-items: center;
    justify-content: center;
